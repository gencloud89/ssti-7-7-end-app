<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:antialias="true"
            android:gravity="fill"
            android:src="@drawable/brandlogo_shell" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#14FFFFFF"
                android:endColor="#2AFFFFFF"
                android:startColor="#0EFFFFFF" />
        </shape>
    </item>
    <item
        android:gravity="top|center_horizontal"
        android:height="260dp"
        android:width="360dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/sennet_glow_center"
                android:endColor="@color/sennet_glow_end"
                android:gradientRadius="180dp"
                android:startColor="@color/sennet_glow_start"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:height="260dp"
        android:width="260dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/sennet_glow_lavender"
                android:endColor="@color/sennet_glow_end"
                android:gradientRadius="200dp"
                android:startColor="#00FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="bottom|end"
        android:height="280dp"
        android:width="280dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/sennet_glow_mint"
                android:endColor="@color/sennet_glow_end"
                android:gradientRadius="220dp"
                android:startColor="#00FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
